{
  "name": "server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-Agent Discovery Platform backend (Express + TypeScript)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.0",
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "chromadb": "^1.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "duck-duck-scrape": "^2.2.0",
    "express": "^4.21.0",
    "ipaddr.js": "^2.2.0",
    "openai": "^4.70.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}