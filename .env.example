# ─────────────────────────────────────────────────────────────
# Multi-Agent Discovery Platform — environment template
# Copy to `.env` (server reads server/.env, client reads client/.env)
# All providers below are FREE tier. No paid service is contacted.
# ─────────────────────────────────────────────────────────────

# ── LLM providers (failover order: groq → cerebras → gemini → ollama) ──
# Groq — https://console.groq.com/keys  (free: ~30 RPM, 14,400 req/day)
GROQ_API_KEY=

# Cerebras — https://cloud.cerebras.ai/  (free: ~30 RPM, 1M tokens/day)
CEREBRAS_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey  (free: 1,500 RPD Flash)
GEMINI_API_KEY=

# Ollama (local, offline) — no real key required
OLLAMA_API_KEY=dummy
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Optional model overrides ──
# Each provider has a built-in default; uncomment to pin a different model.
# Groq:     https://console.groq.com/docs/models
# Cerebras: https://inference-docs.cerebras.ai/models/overview
# Gemini:   https://ai.google.dev/gemini-api/docs/models
# NOTE: Groq decommissioned llama3-8b-8192 / llama-3.3-70b-versatile.
#GROQ_MODEL=openai/gpt-oss-120b
#CEREBRAS_MODEL=llama3.3-70b
#GEMINI_MODEL=gemini-2.5-flash
#OLLAMA_MODEL=llama3.2

# ── Server ──
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Path to the agent capability registry (comma-separated = federated mode)
REGISTRY_PATH=src/registry/agents.json

# Optional: self-hosted SearXNG / Jiro JSON endpoint (9 engines, free forever).
# When set it becomes the FIRST search provider in the chain.
# SEARCH_URL=http://localhost:8888/search

# Optional: point the embedding/discovery layer at a ChromaDB server.
# When unset, an in-process cosine index over @xenova/transformers is used.
# CHROMA_URL=http://localhost:8000

# Optional tunables
# MAX_PIPELINE_STEPS=50
# MAX_RUNS=100
# LOG_LEVEL=debug

# ── Client (Vite) ──
# Points the React app at the backend API.
VITE_API_URL=http://localhost:3001
